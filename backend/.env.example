# Copy to .env and adjust for your environment.
# SQLite is fine for local dev; point at Postgres in a real deployment.
DATABASE_URL=sqlite:///./sahaayak.db

# Signs the anonymous-session cookie. Change this for any real deployment -
# the dev default here is intentionally weak and public.
SESSION_SECRET=dev-secret-change-me

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
